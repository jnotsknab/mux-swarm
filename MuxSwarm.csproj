<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>14</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
        <!-- Keep in sync with App.Version (VersionMetadataTests enforces it). Shown in Windows file properties. -->
        <Version>0.16.0-nightly.20261018</Version>
        <FileVersion>0.16.0</FileVersion>
        <AssemblyVersion>0.16.0.0</AssemblyVersion>

        <Product>Mux-Swarm</Product>
        <Company>github.com/jnotsknab</Company>
        <Description>Highly Configurable Agentic Swarm OS Harness</Description>
        <Copyright>Copyright (c) jnotsknab. Licensed under GPL-3.0.</Copyright>
        <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
        <AssemblyTitle>Mux-Swarm Engine</AssemblyTitle>
        <RepositoryUrl>https://github.com/jnotsknab/mux-swarm</RepositoryUrl>
        <PackageProjectUrl>https://github.com/jnotsknab/mux-swarm</PackageProjectUrl>
        <!-- Windows executable icon (the web UI favicon, Assets/mux-logo.svg). PE-only: Linux/macOS binaries carry no icon. -->
        <ApplicationIcon>Assets\mux.ico</ApplicationIcon>
    </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MuxSwarm.Tests" />
  </ItemGroup>

    <ItemGroup>

        <Content Include="Runtime\**\*.*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>Always</CopyToPublishDirectory>
        </Content>

        <Content Include="Prompts\**\*.*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>Always</CopyToPublishDirectory>
        </Content>

        <Content Include="Context\**\*.*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>Always</CopyToPublishDirectory>
        </Content>
        
        <Content Include="Configs\**\*.*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>Always</CopyToPublishDirectory>
        </Content>

        <Content Include="Skills\**\*.*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>Always</CopyToPublishDirectory>
        </Content>

        <Content Include="Sessions\**\*.*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>Always</CopyToPublishDirectory>
        </Content>

    </ItemGroup>

    <ItemGroup>
        <Compile Remove="Runtime\**" />
        <Compile Remove="Prompts\**" />
        <Compile Remove="Configs\**" />
        <Compile Remove="Skills\**" />
        <Compile Remove="Sessions\**" />
        <None Remove="MuxSwarm.Tests\**" />
        <Compile Remove="MuxSwarm.Tests\**" />
        <None Remove="Runtime\**" />
        <None Remove="Prompts\**" />
        <None Remove="Configs\**" />
        <None Remove="Skills\**" />
        <None Remove="Sessions\**" />
        <Compile Remove="Context\**" />
        <None Remove="Context\**" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Agents.AI" Version="1.3.0" />
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <PackageReference Include="Microsoft.Extensions.AI" Version="10.5.0" />
        <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.5.0" />
        <PackageReference Include="ModelContextProtocol" Version="2.0.0" />
        <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
        <PackageReference Include="OpenAI" Version="2.10.0" />
        <PackageReference Include="OpenTelemetry" Version="1.15.3" />
        <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3" />
        <PackageReference Include="Spectre.Console" Version="0.54.0" />
    </ItemGroup>

</Project>